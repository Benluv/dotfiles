{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/dev/assets/oh-my-opencode.schema.json",
  "hooks": {
    "anthropic-context-window-limit-recovery": { "enabled": true },
    "session-recovery": { "enabled": true },
    "compaction-todo-preserver": { "enabled": true },
    "compaction-context-injector": { "enabled": true }
  },
  "experimental": {
    "aggresive_truncation": true,
    "preemptive_compaction": true,
    "task_system": true,
    "auto_resume": true
  },
  "tmux": {
    "enabled": true
  },
  "agents": {
    "sisyphus": {
      "model": "github-copilot-enterprise/claude-opus-4.6",
      "variant": "max",
      "ultrawork": { "model": "anthropic/claude-opus-4.6", "variant": "max" }
    },
    "oracle": {
      "model": "github-copilot-enterprise/gpt-5.4",
      "variant": "high"
    },
    "librarian": {
      "model": "github-copilot-enterprise/gemini-3-flash-preview"
    },
    "explore": {
      "model": "github-copilot-enterprise/gpt-5-mini"
    },
    "multimodal-looker": {
      "model": "github-copilot-enterprise/gemini-3-flash-preview"
    },
    "prometheus": {
      "model": "github-copilot-enterprise/claude-opus-4.6",
      "variant": "max",
      "prompt_append": "Leverage deep & quick agents heavily, always in parallel."
    },
    "metis": {
      "model": "github-copilot-enterprise/claude-opus-4.6",
      "variant": "max"
    },
    "momus": {
      "model": "github-copilot-enterprise/gpt-5.4",
      "variant": "xhigh"
    },
    "atlas": {
      "model": "github-copilot-enterprise/gemini-3.1-pro-preview",
      "prompt_append": "Leverage deep & quick agents heavily, always in parallel.",
      "steps": 25,
      "tools": {
        "read": false
      }
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "github-copilot-enterprise/gemini-3.1-pro-preview",
      "variant": "high"
    },
    "ultrabrain": {
      "model": "github-copilot-enterprise/gemini-3.1-pro-preview",
      "variant": "high"
    },
    "artistry": {
      "model": "github-copilot-enterprise/gemini-3.1-pro-preview",
      "variant": "high"
    },
    "quick": {
      "model": "github-copilot-enterprise/claude-haiku-4.5"
    },
    "unspecified-low": {
      "model": "github-copilot-enterprise/claude-sonnet-4.6"
    },
    "unspecified-high": {
      "model": "github-copilot-enterprise/claude-sonnet-4.6"
    },
    "writing": {
      "model": "github-copilot-enterprise/gemini-3-flash-preview"
    }
  }
}
