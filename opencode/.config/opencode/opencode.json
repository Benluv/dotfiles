{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-handoff"
  ],
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**", ".meteor/**"]
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai",
      "name": "LiteLLM",
      "options": {
        "baseURL": "http://servia.depid.local:4000/v1",
        "apiKey": "sk-1234"
      },
      "models": {
        "gpt-5.1-codex-mini": {
          "name": "Gpt 5.1 Codex Mini"
        },
        "gpt-5.2-codex": {
          "name": "Gpt 5.2 Codex"
        },
        "text-embedding-3-small": {
          "name": "Text Embedding 3 Small"
        },
        "model_router": {
          "name": "Model Router"
        }
      }
    }
  },
  "permission": {
    "read": "allow",
    "edit": "ask",
    "glob": "allow",
    "list": "allow",
    "skill": "allow",
    "lsp": "allow",
    "question": "allow",
    "todowrite": "allow",
    "todoread": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": "allow",
    "bash": {
      "*": "ask",

      // BASIC_NAVIGATION
      "ls *": "allow",
      "pwd *": "allow",
      "which *": "allow",

      // GIT
      "git *": "allow",
      "git push *": "ask",

      // RUNTIME_ENVIRONMENTS
      "node *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "pnpm *": "allow",
      "bun *": "allow",
      "bunx *": "allow",
      "python3 *": "allow",
      "python *": "allow",
      "go *": "allow",
      "**/go *": "allow",

      // FILE_OPERATIONS
      "cat *": "allow",
      "grep *": "allow",
      "tail *": "allow",
      "head *": "allow",
      "find *": "allow",
      "sed *": "allow",
      "awk *": "allow",
      "xargs *": "allow",
      "wc *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "cut *": "allow",
      "tr *": "allow",
      "jq *": "allow",

      // BUILD_TOOLS
      "make *": "allow",
      "gcc *": "allow",

      // NETWORK
      "curl *": "allow",
      "wget *": "allow",

      // CONTAINERS_AND_INFRASTRUCTURE
      "docker *": "allow",
      "docker-compose *": "allow",
      "kubectl *": "allow",
      "helm *": "allow",
      "minikube *": "allow",
      "gcloud *": "allow",

      // SYSTEM_MONITORING
      "htop": "allow",
      "free *": "allow",
      "echo *": "allow",
      "nproc *": "allow",
      "uptime *": "allow",
      "ps *": "allow"
    }
  }
}
